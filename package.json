{
  "name": "gymflow",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "node scripts/browser-test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
